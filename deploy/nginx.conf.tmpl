# Rendered by entrypoint.sh (@HOST@, @TOKEN@). Public port 3080 -> oauth2-proxy auth_request -> dsh on 127.0.0.1:3081.
daemon off;
pid /tmp/nginx.pid;
events {}
http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  access_log off;
  error_log /dev/stderr warn;
  absolute_redirect off;
  map $http_upgrade $connection_upgrade { default upgrade; '' close; }
  map $http_cookie $has_cookie { default 0; '~dsh-auth-' 1; }
  map $arg_token $has_token { default 1; '' 0; }
  server {
    listen 3080;
    location /oauth2/ {
      proxy_pass http://127.0.0.1:4180;
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Auth-Request-Redirect $request_uri;
    }
    location = /oauth2/auth {
      internal;
      proxy_pass http://127.0.0.1:4180;
      proxy_set_header Host $host;
      proxy_set_header Content-Length "";
      proxy_pass_request_body off;
    }
    location = /oauth/consent { alias /tmp/auth-ui/index.html; default_type text/html; add_header Cache-Control no-store; }
    # Desktop sign-in: the login page hands the Supabase session to the account gateway (deploy/gateway.mjs).
    location = /dsh/approve { proxy_pass http://127.0.0.1:4300; }
    location /auth-ui/ { alias /tmp/auth-ui/; add_header Cache-Control no-store; }
    # Only page navigations start a sign-in; scripts and API calls get 401 instead of each starting its own.
    location @login {
      if ($http_sec_fetch_mode != "navigate") { return 401; }
      return 302 /oauth2/start?rd=$request_uri;
    }
    location = /healthz { access_log off; return 200 'ok'; }
    location / {
      auth_request /oauth2/auth;
      error_page 401 = @login;
      proxy_pass http://127.0.0.1:3082;
      proxy_http_version 1.1;
      proxy_set_header Host $http_host;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_read_timeout 3600s;
    }
  }
  # API host: the desktop account gateway (sign-in protocol and model requests), not the web app.
  server {
    listen 3080;
    server_name @API_HOST@;
    client_max_body_size 64m;
    location / {
      proxy_pass http://127.0.0.1:4300;
      proxy_http_version 1.1;
      proxy_buffering off;
      proxy_request_buffering off;
      proxy_read_timeout 3600s;
    }
  }
  # Reachable only through the authenticated location above: exchanges the launch token for a browser
  # that has no dsh session cookie yet. The `if` must live here because nginx runs it before auth_request.
  server {
    listen 127.0.0.1:3082;
    location / {
      set $need "$has_cookie$has_token";
      if ($need = "00") { return 302 "/?token=@TOKEN@"; }
      proxy_pass http://127.0.0.1:3081;
      proxy_http_version 1.1;
      proxy_set_header Host $http_host;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_read_timeout 3600s;
      proxy_cookie_flags ~ secure;
    }
  }
}
