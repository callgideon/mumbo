// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`sidebar shell snapshots > renders Windows caption controls in expanded and collapsed states > windows collapsed 1`] = `
<div
  data-slot="sidebar"
  style="display: contents;"
>
  <div
    class="root collapsed railIn quietBars"
    style=""
  >
    <div
      class="logoRow"
      data-window-drag="true"
    >
      <button
        aria-label="Open sidebar"
        class="iconButton toggle"
        data-sidebar-toggle="true"
        type="button"
      >
        <svg
          aria-hidden="true"
          class="panelIcon"
          data-content="d95b7908"
          data-icon="dsw-icon-panel-left-outline-regular"
          height="16"
          width="16"
        />
        <div
          data-slot="sidebar.toggle.badge"
          style="display: contents;"
        />
      </button>
    </div>
    <button
      aria-label="New session"
      class="newSession"
      type="button"
    >
      <span
        class="newSessionLabelMask"
      >
        <span
          class="newSessionContent"
        >
          <svg
            aria-hidden="true"
            data-content="6e5e38f3"
            data-icon="dsw-icon-new-chat-outline-regular"
            height="16"
            width="16"
          />
        </span>
      </span>
    </button>
    <div
      class="scrollRegion"
    >
      <div
        class="scrollArea"
      >
        <div
          class="regionArea"
        >
          <div
            data-slot="sidebar.workspaces"
            style="display: contents;"
          />
        </div>
      </div>
      <span
        aria-hidden="true"
        class="scrollFade"
      />
    </div>
    <div
      class="footArea"
    >
      <div
        class="footerActions"
      >
        <div
          data-slot="sidebar.footer.action"
          style="display: contents;"
        />
      </div>
      <div
        class="settingsArea"
      >
        <div
          data-slot="sidebar.settings"
          style="display: contents;"
        />
      </div>
    </div>
  </div>
</div>
`;

exports[`sidebar shell snapshots > renders Windows caption controls in expanded and collapsed states > windows expanded 1`] = `
<div
  data-slot="sidebar"
  style="display: contents;"
>
  <div
    class="root quietBars"
    style="width: 300px;"
  >
    <div
      class="logoRow"
      data-window-drag="true"
    >
      <button
        aria-label="New session"
        class="brand wide"
        type="button"
      >
        <span
          aria-hidden="true"
          class="brandIdentity"
        >
          <span
            class="brandMark"
          >
            <div
              data-slot="sidebar.brand.mark"
              style="display: contents;"
            >
              <span
                class="copyVersion"
                data-copy-version="true"
              >
                <svg
                  aria-hidden="true"
                  data-content="965fe321"
                  fill="none"
                  height="17.6580310880829"
                  viewBox="0 0 23.16 17.04"
                  width="24"
                />
              </span>
            </div>
          </span>
          <span
            class="brandName"
          >
            <div
              data-slot="sidebar.brand.name"
              style="display: contents;"
            >
              <span
                class="localBuildBrand copyVersion"
                data-copy-version="true"
              >
                <span
                  class="localBuildTitle"
                >
                  DSH Local Build
                </span>
                <span
                  class="buildVersion"
                >
                  1.2.3-rc.4-abc1234-dirty
                </span>
              </span>
            </div>
          </span>
        </span>
      </button>
      <button
        aria-label="Collapse sidebar"
        class="iconButton toggle"
        data-sidebar-toggle="true"
        type="button"
      >
        <svg
          aria-hidden="true"
          class="panelIcon"
          data-content="d95b7908"
          data-icon="dsw-icon-panel-left-outline-regular"
          height="16"
          width="16"
        />
      </button>
    </div>
    <button
      aria-label="New session"
      class="newSession"
      type="button"
    >
      <span
        class="newSessionLabelMask"
      >
        <span
          class="newSessionContent"
        >
          <svg
            aria-hidden="true"
            data-content="532cf99a"
            data-icon="dsw-icon-new-chat-outline-medium"
            height="14"
            width="14"
          />
          <span
            class="newSessionLabel wide"
          >
            New Session
          </span>
        </span>
      </span>
    </button>
    <div
      class="scrollRegion"
    >
      <div
        class="scrollArea"
        data-sidebar-scrollport=""
      >
        <div
          class="regionArea"
        >
          <div
            data-slot="sidebar.workspaces"
            style="display: contents;"
          />
        </div>
      </div>
      <span
        aria-hidden="true"
        class="scrollFade"
      />
    </div>
    <div
      class="footArea"
    >
      <div
        class="footerActions"
      >
        <div
          data-slot="sidebar.footer.action"
          style="display: contents;"
        />
      </div>
      <div
        class="settingsArea"
      >
        <div
          data-slot="sidebar.settings"
          style="display: contents;"
        />
      </div>
    </div>
  </div>
</div>
`;

exports[`sidebar shell snapshots > renders a Session row above Plugins, selected while its Session is open, in the column, the rail, and the drawer > session row drawer 1`] = `
<nav
  aria-label="Global panels"
  class="panelList"
>
  <div
    class="panelEntry panelEntryWide panelEntryActive"
  >
    <button
      aria-current="page"
      aria-label="Mumbo"
      class="panelRow"
      type="button"
    >
      <span
        aria-hidden="true"
        class="panelGlyph"
      >
        <div
          data-slot="sidebar.panellist"
          style="display: contents;"
        >
          <svg
            aria-hidden="true"
            data-content="b22c03dd"
            data-icon="dsw-icon-sparkle-regular"
            height="16"
            width="16"
          />
        </div>
      </span>
      <span
        class="panelTitle wide"
      >
        Mumbo
      </span>
    </button>
  </div>
  <div
    class="panelEntry panelEntryWide"
  >
    <button
      aria-label="Plugins"
      class="panelRow"
      type="button"
    >
      <span
        aria-hidden="true"
        class="panelGlyph"
      >
        <div
          data-slot="sidebar.panellist"
          style="display: contents;"
        >
          <svg
            aria-hidden="true"
            data-content="d251ef04"
            data-icon="dsw-icon-plugin-pinwheel-outline-regular"
            height="16"
            width="16"
          />
        </div>
      </span>
      <span
        class="panelTitle wide"
      >
        Plugins
      </span>
    </button>
  </div>
</nav>
`;

