#!/usr/bin/env node
// Offline dws stand-in reporting a signed-in user.
const args = process.argv.slice(2).join(' ')
if (args !== 'auth status --readonly --format json') {
  process.stderr.write(`unexpected dws arguments: ${args}\n`)
  process.exit(1)
}
process.stdout.write(`${JSON.stringify({ success: true, authenticated: true, corp_name: 'Snapshot Org', user_name: 'Snapshot User' }, null, 2)}\n`)
